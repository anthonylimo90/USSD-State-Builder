{
  "name": "ussd-state-builder",
  "version": "3.0.0",
  "description": "A complete state machine for building USSD applications with back navigation, lifecycle hooks, middleware, validation, i18n, testing utilities, health checks, and multiple storage adapters",
  "main": "index.js",
  "module": "index.mjs",
  "types": "types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "types": "./types/index.d.ts"
    },
    "./sdk": {
      "import": "./sdk.mjs",
      "require": "./sdk.js",
      "types": "./types/sdk.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "RUN_INTEGRATION=1 jest tests/integration",
    "lint": "eslint .",
    "test:package": "node scripts/verify-package.mjs",
    "test:packed-demo": "node scripts/verify-packed-mavuno.mjs",
    "test:onboarding": "node scripts/verify-workbench-onboarding.mjs",
    "test:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext types/index.d.ts types/sdk.d.ts tests/types/metrics.ts",
    "demo:live-market": "node examples/live-market/server.js",
    "workbench": "node examples/workbench/server.js",
    "workbench:onboarding": "node examples/workbench/onboarding/server.js",
    "benchmark": "node benchmarks/benchmark.js",
    "demo:metrics": "node examples/metrics/server.js",
    "test:metrics-prometheus": "node scripts/verify-metric-prometheus.mjs"
  },
  "keywords": [
    "ussd",
    "state-machine",
    "nodejs",
    "mobile",
    "africa",
    "telecom",
    "sms",
    "menu",
    "navigation",
    "middleware",
    "validation",
    "redis",
    "mongodb",
    "postgresql",
    "i18n",
    "testing",
    "caching",
    "analytics",
    "encryption",
    "prometheus",
    "opentelemetry",
    "webhook",
    "plugin",
    "simulator",
    "benchmark"
  ],
  "author": "ANTHONY KIPLIMO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonylimo90/USSD-State-Builder.git"
  },
  "bugs": {
    "url": "https://github.com/anthonylimo90/USSD-State-Builder/issues"
  },
  "homepage": "https://github.com/anthonylimo90/USSD-State-Builder#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "optionalDependencies": {
    "mongodb": "^6.0.0",
    "pg": "^8.0.0",
    "redis": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "jest": "^27.0.6",
    "typescript": "^5.9.3"
  }
}
